AGENT_URL=https://cloudflare-agents-sdk-test.YOUR_SUBDOMAIN.workers.dev
RELAY_TOKEN=replace-with-the-same-random-worker-secret
DATABASE_URL=postgresql://localhost/course_agent

# Use the same repository-scoped read/write PAT here and in the Worker secret GITHUB_TOKEN.
# The sandbox never receives the token itself.
GITHUB_TOKEN=replace-with-your-repository-pat
PUSH_BRANCH=main
