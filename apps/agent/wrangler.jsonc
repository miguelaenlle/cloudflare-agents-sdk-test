{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-agents-sdk-test",
  "main": "agent.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "UI_ORIGIN": "http://localhost:4315",
    "BACKUP_BUCKET_NAME": "codex-playground-backups",
    "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Chat", "class_name": "Chat" },
      { "name": "Sandbox", "class_name": "Sandbox" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Chat"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
  ],
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "codex-playground-backups" },
  ],
}
