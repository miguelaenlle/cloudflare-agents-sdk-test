{
  "name": "@playground/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/platform.mjs --experimental-strip-types --test test/codex.test.ts test/app-server.test.ts",
    "test:native": "node --experimental-strip-types --test test/native.test.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "dev": "wrangler dev --config wrangler.jsonc --port 8790 --inspector-port 0 --var LOCAL_DEV:true --persist-to .wrangler/local"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.0",
    "@cloudflare/sandbox": "0.12.9",
    "@playground/chat-contract": "workspace:*",
    "agents": "0.23.0",
    "ai": "^7.0.102",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@openai/codex": "0.155.0",
    "@types/node": "^24.13.5",
    "wrangler": "^4.134.0"
  }
}
